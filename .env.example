# Salin ke .env lalu isi. JANGAN commit .env — sudah masuk .gitignore.
# Semua nilai di bawah punya default di config.py; yang wajib hanya blok AUTH dan
# minimal SATU kunci provider LLM, selebihnya boleh dibiarkan kosong.

# ------------------------------------------------------------------ akses web
AUTH_USER=admin
AUTH_PASSWORD=isi-password-login
SESSION_SECRET=isi-string-acak-64-hex
PORT=8800
HOST=127.0.0.1
# COOKIE_SECURE=0 hanya kalau melayani lewat http polos (mis. localhost tanpa TLS).
COOKIE_SECURE=1

# Mode tamu (read-only, dibatasi beberapa emiten). Kosongkan GUEST_PASSWORD untuk mematikan.
GUEST_USER=
GUEST_PASSWORD=
GUEST_TICKERS=BBCA,BBRI,BMRI,TLKM,ASII
GUEST_DAILY_ANALYST=5

# ------------------------------------------------------------------ provider LLM
# Isi yang kamu punya saja; chain di config.py melewati provider tanpa kunci.
# Jalankan `python tools/provider_audit.py` untuk melihat mana yang benar-benar hidup —
# pin model membusuk diam-diam (model ditarik, kredit habis, kunci dicabut).
NARA_API_KEY=
NARA_KEY_FREE=
NARA_KEY_SMART=
MISTRAL_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
GLM_API_KEY=
NVIDIA_API_KEY_ANALYST=
NVIDIA_API_KEY_TRADER=
# Diisi = claude-fable-5 jadi PRIMARY di SEMUA rantai peran (USE_FABLE5=true bawaan), sehingga
# susunan pin berbeda dari Tabel 3.1 naskah. Kosongkan untuk mereproduksi susunan naskah.
ANTHROPIC_API_KEY=
DAHL_API_KEY=

# ------------------------------------------------------------------ perilaku mesin
USE_LLM=true
# true = ticker dilewati kalau SEMUA provider gagal, bukan diam-diam turun ke heuristik
# lalu dicatat seolah keputusan agen. Matikan hanya kalau kamu sadar konsekuensinya.
LLM_STRICT=true
RUN_ENGINE=1
# Nilai di blok ini = default config.py = susunan yang diukur di naskah skripsi: siklus 12 menit,
# 2 kandidat ke rantai agen di luar jam bursa dan 2x lipat (4) saat bursa buka.
AGENT_CYCLE_MIN=12
CANDIDATES_PER_CYCLE=2
LLM_PARALLEL=1
USE_COUNCIL=true
SENTIMENT_AGENT=true
AUTO_TUNE=true
SHADOW_ARMS=true

# ------------------------------------------------------------------ paper trading
START_CASH=100000000
MIN_PRICE=50
MIN_TURNOVER=1000000000
STOP_LOSS_PCT=-10
TAKE_PROFIT_PCT=20
MAX_HOLD_DAYS=15
# Gerbang 9 (anti-churn) pada Tabel 3.5 naskah: 6 jam.
REENTRY_COOLDOWN_HOURS=6

# ------------------------------------------------------------------ opsional
# Proxy untuk situs IDX bila IP-mu diblok Cloudflare (umumnya IP datacenter).
IDX_PROXY=
# Mode cermin: instance kedua yang hanya menyalin DB dari instance utama.
MIRROR_UPSTREAM=
MIRROR_SECRET=
MIRROR_INTERVAL=300
# tools/push_idxflow.py — dorong arus asing dari mesin ber-IP residensial ke server.
PUSH_HOST=
PUSH_KEY=
PUSH_REMOTE=~/Prediction/data/foreign_flow.json
